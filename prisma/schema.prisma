generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  isVerified          Boolean  @default(false)
  name                String
  slug                String   @unique
  // Profile
  logoUrl             String?
  description         String?
  category            String?
  contactPhone        String?
  address             Json?    // { street, city, state, country, postalCode }
  socialLinks         Json?    // { whatsapp, instagram, twitter, facebook, website }
  // Operations
  hours               Json?    // { mon: { open: "09:00", close: "17:00", closed: false }, ... }
  policies            String?  // Markdown/plain text: return, refund, cancellation
  deliveryInfo        String?  // Plain text delivery info
  supportedLanguages  String[] @default(["en"])
  // AI
  aiConfig            Json?    // { persona, tone, rules, permittedActions, escalationTriggers }
  products            Product[]
  customers           Customer[]
  conversations       Conversation[]
  orders              Order[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Product {
  id             String      @id @default(uuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  priceKobo      Int
  discountKobo   Int         @default(0) // If set, effective price = priceKobo - discountKobo
  currency       String      @default("NGN")
  imageUrl       String?
  isAvailable    Boolean     @default(true)
  stockQuantity  Int?
  tags           String[]
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([businessId])
  @@index([isAvailable])
}

model Customer {
  id            String         @id @default(uuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String?
  phone         String?
  email         String?
  channel       String         @default("web_chat") // 'web_chat' | 'voice'
  conversations Conversation[]
  orders        Order[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([businessId])
}

model Conversation {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  status      String   @default("active") // 'active' | 'handed_off' | 'closed'
  messages    Json     @default("[]")
  orders      Order[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

model Order {
  id              String        @id @default(uuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  conversationId  String?
  conversation    Conversation? @relation(fields: [conversationId], references: [id])
  status          String        @default("draft") // 'draft' | 'confirmed' | 'paid' | 'cancelled'
  totalKobo       Int           @default(0)
  currency        String        @default("NGN")
  idempotencyKey  String        @unique
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([businessId])
  @@index([status])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  unitPriceKobo   Int
  createdAt       DateTime @default(now())
}