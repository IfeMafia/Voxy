  "item": [
    {
      "name": "T1: Health & System Baseline [BE-101]",
      "item": [
        {
          "name": "Health Check (DB Connectivity)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Health status is ok\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('object');",
                  "    pm.expect(json.data.status).to.eql('ok');",
                  "    pm.expect(json.error).to.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check server status and database connectivity (Neon PostgreSQL via Prisma)."
          }
        }
      ]
    },
    {
      "name": "T3: Authentication & Identity [BE-103]",
      "item": [
        {
          "name": "Sign Up (Register Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Token returned and captured\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.error).to.be.null;",
                  "    pm.expect(res.data).to.have.property('token');",
                  "    pm.expect(res.data.user).to.have.property('id');",
                  "    pm.collectionVariables.set('authToken', res.data.token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner_{{$timestamp}}@voxytest.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Test Business Owner\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "description": "Register a new business owner. Generates a fresh JWT token and sets {{authToken}}."
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 or 401\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 401]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.data && res.data.token) {",
                  "        pm.collectionVariables.set('authToken', res.data.token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@voxytest.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticate an existing user with email and password."
          }
        },
        {
          "name": "Get Current User Profile (Me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User profile returned without passwordHash\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.error).to.be.null;",
                  "    pm.expect(res.data.user).to.have.property('email');",
                  "    pm.expect(res.data.user).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Fetches current session user profile using JWT token."
          }
        }
      ]
